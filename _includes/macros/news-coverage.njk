{% macro newsLink(item) -%}
  {% if item.publicUrl %}<a href="{{ item.publicUrl }}" target="_blank" rel="noopener noreferrer">{{ item.title }}<span class="visually-hidden"> (opens in a new tab)</span></a>{% else %}{{ item.title }}{% endif %}
{%- endmacro %}

{% macro newsLabels(item) -%}
  {% if item.video %} <span class="news-label">Video</span>{% endif %}
{%- endmacro %}

{% macro newsList(items) %}
  <ul class="news-list">
    {% for item in items %}
      <li>
        <p class="news-meta"><span class="news-outlet">{{ item.outlet_short }}</span>{% if item.displayDate %} · <time datetime="{{ item.date }}">{{ item.displayDate }}</time>{% endif %}{{ newsLabels(item) }}</p>
        <p class="news-title">{{ newsLink(item) }}</p>
        {% if item.summary %}<p class="news-summary">{{ item.summary }}</p>{% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{% macro newsCoverage(coverage, compiled, headingTag="h2", idPrefix="") %}
  {% if coverage.raceItems.length %}
    {% set headingId = idPrefix ~ "news-coverage-heading" %}
    <section class="news-coverage" aria-labelledby="{{ headingId }}">
      <{{ headingTag }} id="{{ headingId }}" class="news-coverage-heading">News coverage</{{ headingTag }}>
      {{ newsList(coverage.raceItems) }}
      <div class="news-notes">
        {% if coverage.roundups.length %}
          <p class="news-roundups">Also covering all 15 wards:
            {% for item in coverage.roundups %}
              <span class="news-roundup">{{ item.outlet_short }}: {{ newsLink(item) }}{% if item.displayDate %} (<time datetime="{{ item.date }}">{{ item.displayDate }}</time>){% endif %}{{ newsLabels(item) }}</span>{% if not loop.last %} · {% endif %}
            {% endfor %}
          </p>
        {% endif %}
        <p class="news-source-note">Coverage compiled from the Winnipeg Free Press and CBC Manitoba, {{ compiled }}. <a href="/about/#news-coverage">How we chose these articles</a>.</p>
      </div>
    </section>
  {% endif %}
{% endmacro %}
