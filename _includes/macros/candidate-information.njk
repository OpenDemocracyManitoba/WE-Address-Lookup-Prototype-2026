{% macro disclosureListItem(disclosure, fallbackLabel) %}
  {% if disclosure.publicUrl %}
    <li><a href="{{ disclosure.publicUrl }}">{{ disclosure.fileName or fallbackLabel }}</a></li>
  {% elif disclosure.fileName %}
    <li>{{ disclosure.fileName }}</li>
  {% endif %}
{% endmacro %}

{% macro candidateInformation(contest, headingTag="h2", nameTag="h2", subheadingTag="h3", idPrefix="") %}
  {% set headingId = idPrefix ~ "candidate-information-heading" %}
  {% if contest.candidateList.availability == "Unavailable" %}
    <section class="candidate-list-notice" aria-labelledby="{{ headingId }}">
      <{{ headingTag }} id="{{ headingId }}">Candidate list unavailable</{{ headingTag }}>
      <p>This resource does not currently support Candidate data for this Contest. This does not mean that no Candidates exist.</p>
    </section>
  {% elif contest.candidates.length == 0 %}
    <section class="candidate-list-notice" aria-labelledby="{{ headingId }}">
      <{{ headingTag }} id="{{ headingId }}">No published Candidate Records</{{ headingTag }}>
      <p>The reviewed Candidate list is published, but it contained no Candidate Records when observed.</p>
    </section>
  {% else %}
    {% set explanationId = idPrefix ~ "candidate-order-explanation" %}
    <section aria-label="{{ contest.office }} Candidates">
      <p id="{{ explanationId }}" class="ordering-explanation" data-order-explanation><span class="ordering-label">LIST ORDER / </span><span data-order-message>Candidates are shown alphabetically by family name.</span></p>
      <ul class="candidate-list" data-candidate-list aria-describedby="{{ explanationId }}">
        {% for candidate in contest.candidates %}
          <li class="candidate-list-item" data-candidate-record>
            <article class="candidate-record">
              <p class="candidate-role">{{ contest.office }} Candidate</p>
              <{{ nameTag }}>{{ candidate.sourcePublishedName }}</{{ nameTag }}>

              {% if candidate.presentation.imageUrl %}<img class="candidate-image" src="{{ candidate.presentation.imageUrl }}" alt="{{ candidate.sourcePublishedName }}" />{% endif %}

              {% if candidate.biography or candidate.biographyFrench %}
                <section class="candidate-biography">
                  <{{ subheadingTag }}>Candidate-provided information</{{ subheadingTag }}>
                  {% if candidate.biography %}<p>{{ candidate.biography }}</p>{% endif %}
                  {% if candidate.biographyFrench %}<p lang="fr">{{ candidate.biographyFrench }}</p>{% endif %}
                </section>
              {% endif %}

              {% if candidate.presentation.campaignUrl or candidate.email or candidate.phone or candidate.presentation.socialLinks.length %}
                <div class="candidate-contact">
                  <{{ subheadingTag }}>Campaign and contact information</{{ subheadingTag }}>
                  <ul>
                    {% if candidate.presentation.campaignUrl %}<li><a href="{{ candidate.presentation.campaignUrl }}">Campaign website</a></li>{% endif %}
                    {% if candidate.email %}<li><a href="mailto:{{ candidate.email }}">{{ candidate.email }}</a></li>{% endif %}
                    {% if candidate.phone %}<li><a href="tel:{{ candidate.presentation.phoneHref }}">{{ candidate.phone }}</a></li>{% endif %}
                    {% for social in candidate.presentation.socialLinks %}
                      <li><a href="{{ social.publicUrl }}">{{ social.label }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

              {% if candidate.presentation.financialDisclosure.publicUrl or candidate.presentation.financialDisclosure.fileName or candidate.presentation.statementOfDisclosure.publicUrl or candidate.presentation.statementOfDisclosure.fileName %}
                <div class="candidate-disclosures">
                  <{{ subheadingTag }}>Disclosure documents</{{ subheadingTag }}>
                  <ul>
                    {{ disclosureListItem(candidate.presentation.financialDisclosure, "Financial disclosure") }}
                    {{ disclosureListItem(candidate.presentation.statementOfDisclosure, "Statement of disclosure") }}
                  </ul>
                </div>
              {% endif %}
            </article>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
{% endmacro %}
