{% from "macros/candidate-information.njk" import candidateInformation %}
{% macro homeContest(contest) %}
<article class="applicable-contest">
  <p class="candidate-role">{{ contest.office }} Contest</p>
  <h3><a href="/contests/{{ contest.id }}/">{{ contest.electoralArea.canonicalName }}</a></h3>
  <dl class="applicable-contest-metadata">
    <div><dt>Number to Elect</dt><dd>{{ contest.numberToElect }}</dd></div>
    <div><dt>Candidate List Availability</dt><dd>{{ contest.candidateList.availability }}</dd></div>
  </dl>

  {{ candidateInformation(contest, "h4", "h4", "h5", contest.id ~ "-") }}
</article>
{% endmacro %}
