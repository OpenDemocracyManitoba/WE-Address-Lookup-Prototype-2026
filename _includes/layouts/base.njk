<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ description }}" />
    <title>{{ title }}</title>
    {% set siteUrl = "https://winnipegelection.ca" %}
    <link rel="canonical" href="{{ siteUrl }}{{ page.url }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WinnipegElection.ca" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ siteUrl }}{{ page.url }}" />
    <meta property="og:image" content="{{ siteUrl }}/assets/og-image.jpg" />
    <meta property="og:image:width" content="2560" />
    <meta property="og:image:height" content="1179" />
    <meta property="og:image:alt" content="The Winnipeg skyline with the Canadian Museum for Human Rights and the Esplanade Riel bridge." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/assets/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">Winnipeg Election 2026</a>
      <nav class="site-navigation" aria-label="Main navigation">
        <a href="/">Address Lookup<span class="navigation-arrow" aria-hidden="true">→</span></a>
        <a href="/contests/">Candidates<span class="navigation-arrow" aria-hidden="true">→</span></a>
        <a href="/about/">About<span class="navigation-arrow" aria-hidden="true">→</span></a>
      </nav>
      <div class="site-resource-note"><a href="https://opendemocracymanitoba.ca">OPEN DEMOCRACY MANITOBA</a><br />WINNIPEG · 2026</div>
    </header>
    <main class="page-shell">
      {{ content | safe }}
    </main>
    {% if lookupPage %}<script type="module" src="/assets/app.js"></script>{% endif %}
    {% if contestPage %}<script type="module" src="/assets/candidate-order.js"></script>{% endif %}
  </body>
</html>
